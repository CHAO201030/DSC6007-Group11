{
  "env": {
    "layout": "cramped_room",
    "horizon": 400,
    "info_level": 0
  },
  "ppo": {
    "hidden_dim": 64,
    "lr": 0.001,
    "gamma": 0.99,
    "eps": 0.2,
    "device": "cpu",
    "value_coef": 0.5,
    "epochs": 4,
    "minibatch_size": 64,
    "max_grad_norm": 0.5
  },
  "train": {
    "episodes": 500,
    "seed": 0,
    "gae_lambda": 0.95,
    "shaping_coef": 1.0,
    "checkpoint_interval": 50,
    "checkpoint_dir": "checkpoints/train",
    "log_path": "checkpoints/train/train_log.jsonl",
    "plot_path": "checkpoints/train/training_curves.png"
  },
  "partner": {
    "type": "random",
    "seed": 1
  }
}
